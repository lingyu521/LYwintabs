#include <windows.h>
#include <commctrl.h>
#include "Resource.h"
#pragma code_page(65001)

IDI_LYWINTABS ICON "LYwintabs.ico"

IDD_RENAME_FAVORITE DIALOGEX 0, 0, 231, 71
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "重命名书签"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "名称", -1, 8, 10, 215, 12
    EDITTEXT IDC_FAVORITE_NAME, 8, 23, 215, 14, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "确定", IDOK, 116, 49, 51, 14
    PUSHBUTTON "取消", IDCANCEL, 172, 49, 51, 14
END

IDD_EXPLORER_SETTINGS DIALOGEX 0, 0, 242, 210
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "LYwintabs 设置"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "界面主题", -1, 10, 13, 86, 12
    COMBOBOX IDC_EXPLORER_THEME, 101, 10, 130, 65, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT "深色会同步切换 Windows 和默认应用模式。", -1, 10, 29, 221, 13
    LTEXT "标签高度", -1, 10, 49, 86, 12
    COMBOBOX IDC_TAB_DENSITY, 101, 46, 130, 55, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT "书签栏高度", -1, 10, 71, 86, 12
    COMBOBOX IDC_FAVORITES_DENSITY, 101, 68, 130, 55, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    CONTROL "显示原生窗口标题", IDC_SHOW_FOLDER_TITLE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 94, 221, 12
    CONTROL "隐藏快速访问工具栏", IDC_HIDE_QUICK_ACCESS_TOOLBAR, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 111, 221, 12
    CONTROL "显示书签栏", IDC_SHOW_BOOKMARKS_BAR, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 128, 221, 12
    CONTROL "开机启动（登录 Windows 后启用插件）", IDC_START_WITH_WINDOWS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 145, 221, 12
    PUSHBUTTON "书签管理器…", IDC_OPEN_BOOKMARK_MANAGER, 10, 168, 72, 14
    PUSHBUTTON "关于…", IDC_ABOUT, 87, 168, 48, 14
    PUSHBUTTON "收藏此文件夹…", IDC_ADD_BOOKMARK_FROM_SETTINGS, 140, 168, 91, 14
    DEFPUSHBUTTON "确定", IDOK, 126, 187, 51, 14
    PUSHBUTTON "取消", IDCANCEL, 180, 187, 51, 14
END

IDD_BOOKMARK_MANAGER DIALOGEX 0, 0, 444, 260
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "LYwintabs 书签管理器"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "书签文件夹", -1, 10, 12, 116, 10
    LTEXT "书签栏", IDC_BOOKMARK_LOCATION, 136, 12, 298, 10, SS_ENDELLIPSIS | SS_NOPREFIX
    CONTROL "", IDC_BOOKMARK_TREE, "SysTreeView32", TVS_HASBUTTONS | TVS_HASLINES | TVS_LINESATROOT | TVS_SHOWSELALWAYS | WS_TABSTOP | WS_BORDER, 10, 27, 116, 195
    CONTROL "", IDC_BOOKMARK_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_TABSTOP | WS_BORDER, 136, 27, 298, 195
    PUSHBUTTON "添加书签…", IDC_BOOKMARK_ADD, 10, 234, 63, 15
    PUSHBUTTON "新建文件夹…", IDC_BOOKMARK_NEW_FOLDER, 79, 234, 73, 15
    PUSHBUTTON "编辑…", IDC_BOOKMARK_EDIT, 164, 234, 59, 15
    PUSHBUTTON "移动到…", IDC_BOOKMARK_MOVE, 229, 234, 55, 15
    PUSHBUTTON "移除", IDC_BOOKMARK_REMOVE, 290, 234, 48, 15
    DEFPUSHBUTTON "确定", IDOK, 383, 234, 51, 15
END

IDD_BOOKMARK_EDITOR DIALOGEX 0, 0, 344, 108
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "编辑书签"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "名称", -1, 10, 13, 302, 10
    EDITTEXT IDC_BOOKMARK_NAME, 10, 25, 324, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "文件夹地址", -1, 10, 48, 302, 10
    EDITTEXT IDC_BOOKMARK_ADDRESS, 10, 60, 264, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "浏览…", IDC_BOOKMARK_BROWSE, 280, 60, 54, 14
    DEFPUSHBUTTON "确定", IDOK, 228, 84, 50, 14
    PUSHBUTTON "取消", IDCANCEL, 284, 84, 50, 14
END

IDD_BOOKMARK_QUICK_ADD DIALOGEX 0, 0, 292, 133
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "添加书签"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "名称", -1, 10, 12, 250, 10
    EDITTEXT IDC_BOOKMARK_NAME, 10, 24, 272, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "文件夹地址", -1, 10, 46, 250, 10
    EDITTEXT IDC_BOOKMARK_ADDRESS, 10, 58, 212, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "浏览…", IDC_BOOKMARK_BROWSE, 228, 58, 54, 14
    LTEXT "保存到", -1, 10, 83, 48, 10
    COMBOBOX IDC_BOOKMARK_DESTINATION, 61, 80, 221, 118, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "添加", IDOK, 176, 107, 50, 14
    PUSHBUTTON "取消", IDCANCEL, 232, 107, 50, 14
END

IDD_BOOKMARK_MOVE DIALOGEX 0, 0, 252, 211
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "移动书签"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "选择目标书签文件夹", -1, 10, 12, 232, 10
    CONTROL "", IDC_BOOKMARK_MOVE_TREE, "SysTreeView32", TVS_HASBUTTONS | TVS_HASLINES | TVS_LINESATROOT | TVS_SHOWSELALWAYS | WS_TABSTOP | WS_BORDER, 10, 27, 232, 145
    DEFPUSHBUTTON "移动", IDOK, 136, 185, 50, 14
    PUSHBUTTON "取消", IDCANCEL, 192, 185, 50, 14
END
